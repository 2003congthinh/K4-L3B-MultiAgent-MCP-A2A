# Competition API shown by the instructor/workspace.
COMPETITION_API_URL=http://127.0.0.1:8081

# Generated once at /register. Never commit the real value.
COMPETITION_TEAM_API_KEY=sk-team-replace_me

# Streamable HTTP endpoint. The same Team API Key is used as Bearer token.
MCP_ENDPOINT=http://127.0.0.1:8001/mcp
